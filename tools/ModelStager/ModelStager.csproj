<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>ModelStager</AssemblyName>
    <RootNamespace>CodeBrix.Audio.MusicGeneration.SkyTNT.ModelStager</RootNamespace>
    <Description>Reproduces this repository's shipped model artifact from upstream, on a machine that has nothing but .NET installed.</Description>
  </PropertyGroup>

  <!--
    The ONLY project in this repository that references CodeBrix.Ollama.ModelManager, and it is not
    packable: the store and the reduction belong to the staging step and never to anything that ships.
    The package comes from nuget.org; nothing here reaches anywhere else. No inference engine is needed -
    the int4 reduction is the model library's own managed code.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Ollama.ModelManager.MitLicenseForever" Version="1.0.262.1044" />
  </ItemGroup>

</Project>
